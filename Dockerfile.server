FROM python:3.12-slim

WORKDIR /opt/eris

# System deps: audio, GUI (headless), build tools, ffmpeg
RUN apt-get update && apt-get install -y --no-install-recommends \
    portaudio19-dev \
    pulseaudio-utils \
    alsa-utils \
    libglib2.0-0 \
    libgl1 \
    libegl1 \
    libxkbcommon0 \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements-linux.txt .
RUN pip install --no-cache-dir -r requirements-linux.txt && \
    pip install --no-cache-dir websockets faster-whisper piper-tts

# Copy source
COPY . .

# Server mode env vars
ENV ERIS_ROLE=server
ENV QT_QPA_PLATFORM=offscreen
ENV PYTHONUNBUFFERED=1
ENV ERIS_API_PORT=8081

# Ports: API(8081) Health(8765) WS(8766)
EXPOSE 8081 8765 8766

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8765/health || exit 1

CMD ["python", "main_server.py"]
