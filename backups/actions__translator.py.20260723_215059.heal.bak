"""Traduccion en tiempo real usando Gemini + fallback local."""
import threading
import time
import re

_clipboard_monitoring = False
_monitor_thread = None
_last_clip_text = ""
_current_target_lang = "es"
_current_source_lang = ""
_on_translation = None

