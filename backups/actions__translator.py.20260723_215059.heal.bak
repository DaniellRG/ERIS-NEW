def _get_api_key():
    try:
        from memory.config_manager import get_gemini_key
        return get_gemini_key()
    except Exception:
        import json, os
        paths = [
            os.path.join(os.environ.get("APPDATA", ""), "ERIS", "config", "api_keys.json"),
            "config/api_keys.json",
        ]
        for p in paths:
            if os.path.isfile(p):
                with open(p) as f:
                    return json.load(f).get("gemini_api_key", "")
    return ""


def _local_fallback(text: str, target_lang: str) -> str:
    lower = text.lower()

    def _replace(m):
        w = m.group(0).lower()
        return SIMPLE_DICT.get(w, m.group(0))

    result = re.sub(r"\b[a-zA-Z]+\b", _replace, text)
    prefix = f"[{target_lang.upper()}] " if target_lang else ""
    return prefix + result


def translate(text: str, target_lang: str = "es", source_lang: str = "") -> str:
    """Traduce texto usando Gemini o fallback local."""
    if not text:
        return ""

    try:
        from google import genai as _genai
        api_key = _get_api_key()
        if api_key:
            client = _genai.Client(api_key=api_key)
            src = f" from {source_lang}" if source_lang else ""
            prompt = (
                f"Translate the following text{src} to {target_lang}.\n"
                f"Return ONLY the translation, no explanations.\n\n"
                f"{text}"
            )
            resp = client.models.generate_content(
                model="gemini-2.0-flash",
                contents=[{"role": "user", "parts": [{"text": prompt}]}],
            )
            result = resp.text.strip() if resp.text else ""
            if result:
                return result
    except Exception:
        pass

    return _local_fallback(text, target_lang)


def _clipboard_monitor_loop(target_lang: str, source_lang: str, interval: float):
    global _last_clip_text, _clipboard_monitoring
    try:
        import pyperclip
    except ImportError:
        _clipboard_monitoring = False
        return

    _last_clip_text = pyperclip.paste()
    while _clipboard_monitoring:
        try:
            current = pyperclip.paste()
            if current and current != _last_clip_text and len(current) < 2000:
                _last_clip_text = current
                translated = translate(current, target_lang, source_lang)
                if translated and _on_translation:
                    _on_translation(current, translated)
                elif translated:
                    print(f"[TRADUCTOR] {current} -> {translated}")
        except Exception:
            pass
        time.sleep(interval)


def start_monitoring(parameters: dict = None, player=None) -> str:
    """Inicia monitoreo del portapapeles para traduccion automatica."""
    global _clipboard_monitoring, _monitor_thread
    if _clipboard_monitoring:
        return "Ya estoy monitoreando el portapapeles."

    params = parameters or {}
    target = params.get("target_lang", "es")
    source = params.get("source_lang", "")
    interval = float(params.get("interval", "1.0"))

    _clipboard_monitoring = True
    _monitor_thread = threading.Thread(
        target=_clipboard_monitor_loop,
        args=(target, source, interval),
        daemon=True,
    )
    _monitor_thread.start()
    return f"Monitoreando portapapeles -> {target.upper()}. Esperando texto..."


def stop_monitoring(parameters: dict = None, player=None) -> str:
    """Detiene el monitoreo del portapapeles."""
    global _clipboard_monitoring
    if not _clipboard_monitoring:
        return "No hay monitoreo activo."
    _clipboard_monitoring = False
    return "Monitoreo detenido."


def translate_text(parameters: dict = None, player=None) -> str:
    """Traduce el texto proporcionado."""
    params = parameters or {}
    text = params.get("text", "")
    target = params.get("target_lang", "es")
    source = params.get("source_lang", "")
    if not text:
        return "No hay texto para traducir."
    result = translate(text, target, source)
    prefix = f"[{source} -> {target}] " if source else f"[-> {target}] "
    return prefix + result


def translator_status(parameters: dict = None, player=None) -> str:
    """Estado del traductor."""
    if _clipboard_monitoring:
        return "Monitoreando portapapeles activo. Ultimo texto traducido disponible."
    return "Traductor inactivo. Usa 'translate_text' para traduccion directa."
