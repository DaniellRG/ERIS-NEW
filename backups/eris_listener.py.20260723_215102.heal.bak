#!/usr/bin/env python3
"""
eris_listener.py — ERIS Voice Wake Word Listener.
Usa OpenWakeWord (ONNX) para detección local de wake word.
Fallback: Google Speech API para transcripción y verificación de "Eris".

Modos:
  - oww: OpenWakeWord hey_jarvis model (local, rápido, sin API)
  - transcription: Google Speech API (requiere internet)
  - hybrid: oww + transcription (por defecto)
"""
import io
import json
import os
import signal
import subprocess
import sys
import time
import wave
from pathlib import Path

import numpy as np
import sounddevice as sd

# ── Config ─────────────────────────────────────────────────────────────────────
ERIS_DIR = Path(__file__).resolve().parent
MAIN_PY = ERIS_DIR / "main.py"
if sys.platform == "win32":
    LOG = Path(os.environ.get("APPDATA", Path.home() / "AppData" / "Roaming")) / "ERIS" / "eris-listen.log"
else:
    LOG = Path.home() / ".local" / "share" / "eris-listen.log"
LOG.parent.mkdir(parents=True, exist_ok=True)

SAMPLE_RATE = 16000
SILENCE_SECONDS = 1.0
MAX_RECORD_SECONDS = 6.0
OWW_THRESHOLD = 0.3  # OpenWakeWord confidence threshold

# ── Logging ────────────────────────────────────────────────────────────────────
def log(msg: str):
    timestamp = time.strftime("%Y-%m-%d %H:%M:%S")
    with open(LOG, "a", encoding="utf-8") as f:
        f.write(f"{timestamp} {msg}\n")

# ── Wake Word Engine ───────────────────────────────────────────────────────────
_oww_initialized = False

def _init_oww_once():
    global _oww_initialized
    if _oww_initialized:
        return True
    try:
        sys.path.insert(0, str(ERIS_DIR))
        from actions.wake_word import init_oww, oww_available
        if oww_available():
            ok = init_oww()
            _oww_initialized = ok
            log(f"OpenWakeWord: {'OK' if ok else 'no disponible'}")
            return ok
        _oww_initialized = False
        return False
    except Exception as e:
        log(f"Error init OWW: {e}")
        return False

def _detect_wake_word_oww(wav_bytes: bytes) -> float:
    try:
        from actions.wake_word import predict
        return predict(wav_bytes)
    except Exception:
        return 0.0

def _detect_wake_word_transcription(wav_bytes: bytes) -> str | None:
    try:
        import speech_recognition as sr
        audio = sr.AudioData(wav_bytes, SAMPLE_RATE, 2)
        text = sr.Recognizer().recognize_google(audio, language="es-ES")
        return text
    except sr.UnknownValueError:
        return None
    except sr.RequestError as e:
        log(f"Error API Google: {e}")
        return None
    except Exception:
        return None

def check_wake_word(wav_bytes: bytes, *, mode: str = "hybrid") -> bool:
    """Check if wake word detected. Returns True if 'Eris' was said."""
    # Stage 1: OpenWakeWord (local, rápido)
    if mode in ("oww", "hybrid"):
        if _init_oww_once():
            conf = _detect_wake_word_oww(wav_bytes)
            if conf >= OWW_THRESHOLD:
                log(f"Wake word detectada! OpenWakeWord (conf={conf:.2f})")
                return True
            if conf > 0.01:
                log(f"OWW conf baja: {conf:.3f}")

    # Stage 2: Transcription fallback (Google Speech)
    if mode in ("transcription", "hybrid"):
        text = _detect_wake_word_transcription(wav_bytes)
        if text:
            log(f"[transc] {text}")
            from actions.wake_word import has_wake_word
            if has_wake_word(text):
                log("Wake word detectada! (transcripción)")
                return True
            log(f"Ignorado: '{text}'")
        else:
            log("[no entendido]")

    return False

# ── VAD Recording ──────────────────────────────────────────────────────────────
def rms(data: bytes) -> float:
    arr = np.frombuffer(data, dtype=np.int16).astype(float)
    return float(np.sqrt(np.mean(arr**2)))

def record_phrase(timeout: float = MAX_RECORD_SECONDS) -> bytes | None:
    """Record audio while voice is detected (energy-based VAD)."""
    frames = []
    triggered = False
    silence_frames = 0
    max_silence = int(SILENCE_SECONDS * SAMPLE_RATE / 8000)
    energy_threshold = 30

    def cb(indata, frames_out, time_info, status):
        nonlocal triggered, silence_frames
        data = bytes(indata)
        energy = rms(data)
        frames.append(data)
        if not triggered:
            if energy > energy_threshold:
                triggered = True
                silence_frames = 0
        else:
            if energy > energy_threshold:
                silence_frames = 0
            else:
                silence_frames += 1

    try:
        with sd.RawInputStream(samplerate=SAMPLE_RATE, blocksize=8000,
                               dtype="int16", channels=1, callback=cb):
            start = time.time()
            while time.time() - start < timeout:
                sd.sleep(250)
                if triggered and silence_frames >= max_silence:
                    break
    except Exception as e:
        log(f"Error grabando: {e}")
        return None

    if not triggered or len(frames) < 3:
        return None

    raw = b"".join(frames)
    buf = io.BytesIO()
    with wave.open(buf, "wb") as wf:
        wf.setnchannels(1)
        wf.setsampwidth(2)
        wf.setframerate(SAMPLE_RATE)
        wf.writeframes(raw)
    return buf.getvalue()

# ── ERIS Launcher ──────────────────────────────────────────────────────────────
def launch_eris():
    log("Lanzando ERIS...")
    try:
        python_exe = str(ERIS_DIR / ".venv_windows" / "Scripts" / "python.exe")
        if not os.path.exists(python_exe):
            python_exe = sys.executable
        subprocess.run([python_exe, str(MAIN_PY)], cwd=str(ERIS_DIR))
    except Exception as e:
        log(f"ERIS error: {e}")
    log("ERIS cerrado. Reanudando escucha.")

# ── Main Loop ──────────────────────────────────────────────────────────────────
_shutdown = False

def _handle_signal(signum, frame):
    global _shutdown
    log(f"Señal {signum}, cerrando...")
    _shutdown = True
    sys.exit(0)

signal.signal(signal.SIGTERM, _handle_signal)
signal.signal(signal.SIGINT, _handle_signal)

def main():
    global _shutdown
    log("=== eris-listen iniciado ===")
    _init_oww_once()

    while not _shutdown:
        log("Escuchando... (decí 'Eris')")
        wav_bytes = record_phrase(timeout=6.0)
        if not wav_bytes:
            continue
        if _shutdown:
            break
        if check_wake_word(wav_bytes, mode="hybrid"):
            launch_eris()

    log("=== eris-listen detenido ===")

if __name__ == "__main__":
    main()
