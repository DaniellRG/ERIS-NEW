"""Sistema de backup - guarda DB, Obsidian, config en ZIP + nube."""
import json
import os
import sys
import time
import zipfile
from pathlib import Path


SCOPES = ["https://www.googleapis.com/auth/drive.file"]
TOKEN_FILE = Path(os.environ.get("APPDATA", Path.home() / "AppData" / "Roaming")) / "ERIS" / "config" / "gdrive_token.json"


def _get_cfg():
    try:
        if getattr(sys, "frozen", False):
            base = Path(sys.executable).parent
        else:
            base = Path(__file__).resolve().parent.parent
        return json.loads((base / "config" / "api_keys.json").read_text(encoding="utf-8"))
    except Exception:
        return {}


def _backup_folder(zipf, folder: Path, arcname: str):
    if not folder.exists():
        return
    for root, dirs, files in os.walk(folder):
        for f in files:
            fp = Path(root) / f
            rel = str(fp.relative_to(folder))
            zipf.write(fp, f"{arcname}/{rel}")


def _get_gdrive_service():
    from google.auth.transport.requests import Request
    from google.oauth2.credentials import Credentials
    from google_auth_oauthlib.flow import InstalledAppFlow
    from googleapiclient.discovery import build

    creds = None
    if TOKEN_FILE.exists():
        creds = Credentials.from_authorized_user_file(str(TOKEN_FILE), SCOPES)
    if not creds or not creds.valid:
        if creds and creds.expired and creds.refresh_token:
            creds.refresh(Request())
        else:
            cfg = _get_cfg()
            client_json = cfg.get("gdrive_client_secret", "")
            if not client_json:
                return None
            flow = InstalledAppFlow.from_client_config(
                json.loads(client_json) if isinstance(client_json, str) else client_json,
                SCOPES,
            )
            creds = flow.run_local_server(port=0)
        TOKEN_FILE.parent.mkdir(parents=True, exist_ok=True)
        with open(str(TOKEN_FILE), "w") as f:
            f.write(creds.to_json())
    return build("drive", "v3", credentials=creds)


def _cloud_push(zip_path: Path) -> str:
    """Upload a backup ZIP to Google Drive."""
    from googleapiclient.http import MediaFileUpload

    service = _get_gdrive_service()
    if service is None:
        return "Google Drive no configurado. Agrega 'gdrive_client_secret' en config/api_keys.json"

    cfg = _get_cfg()
    folder_id = cfg.get("gdrive_folder_id", None)

    file_metadata = {"name": zip_path.name}
    if folder_id:
        file_metadata["parents"] = [folder_id]

    media = MediaFileUpload(str(zip_path), mimetype="application/zip", resumable=True)
    uploaded = (
        service.files()
        .create(body=file_metadata, media_body=media, fields="id, webViewLink")
        .execute()
    )

    size_mb = zip_path.stat().st_size / 1024 / 1024
    link = uploaded.get("webViewLink", "")
    return f"Subido a Google Drive: {zip_path.name} ({size_mb:.1f}MB) ID: {uploaded['id']}" + (f" - {link}" if link else "")


def _create_backup() -> tuple[Path, str]:
    """Create a local backup ZIP. Returns (path, message)."""
    home = Path.home()
    backup_dir = home / "Documents" / "ERIS_Data" / "Backups"
    backup_dir.mkdir(parents=True, exist_ok=True)

    ts = time.strftime("%Y%m%d_%H%M%S")
    zip_path = backup_dir / f"ERIS_backup_{ts}.zip"

    with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as z:
        db_path = home / "Documents" / "ERIS_Data" / "eris_brain.db"
        if db_path.exists():
            z.write(db_path, "DB/eris_brain.db")

        vault = Path(r"D:\Eris_NEW\BaseDatosObsidian\BaseObsiEris")
        if vault.exists():
            _backup_folder(z, vault, "Obsidian")

        config = Path(r"D:\Eris_NEW\config")
        if config.exists():
            _backup_folder(z, config, "Config")

        memory = Path(r"D:\Eris_Source\memory")
        if memory.exists():
            _backup_folder(z, memory, "Memory")

    size_mb = zip_path.stat().st_size / 1024 / 1024
    return zip_path, f"Backup creado: {zip_path.name} ({size_mb:.1f}MB)"


def backup_system(parameters: dict = None, player=None) -> str:
    """Gestiona backups local y en la nube."""
    action = (parameters or {}).get("action", "create")

    if action == "create":
        _, msg = _create_backup()
        return msg

    elif action == "cloud_push":
        backup_dir = Path.home() / "Documents" / "ERIS_Data" / "Backups"
        if not backup_dir.exists():
            return "No hay backups para subir."
        files = sorted(backup_dir.glob("*.zip"), key=lambda f: f.stat().st_mtime, reverse=True)
        if not files:
            return "No hay backups para subir."
        return _cloud_push(files[0])

    elif action == "backup_and_cloud_push":
        zip_path, msg = _create_backup()
        cloud_msg = _cloud_push(zip_path)
        return f"{msg}\n{cloud_msg}"

    elif action == "list":
        backup_dir = Path.home() / "Documents" / "ERIS_Data" / "Backups"
        if not backup_dir.exists():
            return "No hay backups."
        files = sorted(backup_dir.glob("*.zip"), key=lambda f: f.stat().st_mtime, reverse=True)
        if not files:
            return "No hay backups."
        lines = [f"Backups ({len(files)}):"]
        for f in files[:10]:
            size = f.stat().st_size / 1024 / 1024
            ts = time.strftime("%d/%m %H:%M", time.localtime(f.stat().st_mtime))
            lines.append(f"  {f.name} ({size:.1f}MB) - {ts}")
        return "\n".join(lines)

    return "Acciones: create, cloud_push, backup_and_cloud_push, list"
