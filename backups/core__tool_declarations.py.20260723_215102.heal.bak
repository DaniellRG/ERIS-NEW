                "message": {"type": "STRING", "description": "Texto del mensaje"},
            },
            "required": ["action"]
        }
    },
    {
        "name": "dashboard",
        "description": "Dashboard web auto-generado con stats del sistema. Acciones: start (iniciar), stop (detener), status (estado).",
