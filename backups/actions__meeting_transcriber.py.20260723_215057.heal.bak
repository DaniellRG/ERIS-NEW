"""Transcripcion automatica de reuniones: graba audio + STT + guarda."""
import os
import time
import threading
import json
from pathlib import Path


_recording = False
_thread = None
_output_path = ""


def _get_vosk_recognizer():
    import vosk
    model_paths = [
        os.path.join(os.environ.get("APPDATA", ""), "ERIS", "models", "vosk"),
        os.path.join(os.path.dirname(__file__), "..", "models", "vosk"),
    ]
    for mp in model_paths:
        if os.path.isdir(mp):
            model = vosk.Model(mp)
            return vosk.KaldiRecognizer(model, 16000)
    raise FileNotFoundError("Modelo Vosk no encontrado")


def _record_worker(duration: int, output: str, use_vosk: bool, sample_rate: int):
    global _output_path
    import sounddevice as sd
    import queue
    import wave

    q = queue.Queue()

    def _callback(indata, frames, time_info, status):
        q.put(indata.copy())

    audio_data = []
    with sd.InputStream(samplerate=sample_rate, channels=1, callback=_callback):
        start = time.time()
        while _recording and (duration <= 0 or time.time() - start < duration):
            try:
                audio_data.append(q.get(timeout=0.1))
            except Exception:
                pass

    import numpy as np
    full = np.concatenate(audio_data, axis=0) if audio_data else np.array([], dtype=np.float32)
    raw_bytes = (full * 32767).astype(np.int16).tobytes()

    os.makedirs(os.path.dirname(output), exist_ok=True)

    with wave.open(output.replace(".txt", ".wav"), "wb") as wf:
        wf.setnchannels(1)
        wf.setsampwidth(2)
        wf.setframerate(sample_rate)
        wf.writeframes(raw_bytes)

    text = _transcribe(raw_bytes, sample_rate, use_vosk)

    with open(output, "w", encoding="utf-8") as f:
        f.write(text)

    _output_path = output


def _transcribe(audio_bytes: bytes, sample_rate: int, use_vosk: bool) -> str:
    if use_vosk:
        try:
            rec = _get_vosk_recognizer()
            rec.AcceptWaveform(audio_bytes)
            res = json.loads(rec.FinalResult())
            return res.get("text", "")
        except Exception:
            pass

    try:
        import speech_recognition as sr
        recognizer = sr.Recognizer()
        audio = sr.AudioData(audio_bytes, sample_rate, 2)
        return recognizer.recognize_google(audio, language="es-ES")
    except Exception:
        return "[Error de transcripcion]"


def _summarize_text(text: str) -> str:
    try:
        from google import genai as _genai
        from memory.config_manager import get_gemini_key
        key = get_gemini_key()
        if not key:
            return ""
        client = _genai.Client(api_key=key)
        prompt = (
            "Resume la siguiente transcripcion de reunion en puntos clave.\n"
            "Incluye: temas principales, decisiones tomadas, pendientes.\n\n"
            f"{text}"
        )
        resp = client.models.generate_content(
            model="gemini-2.0-flash",
            contents=[{"role": "user", "parts": [{"text": prompt}]}],
        )
        return resp.text.strip() if resp.text else ""
    except Exception:
        return ""


def start_transcription(parameters: dict = None, player=None) -> str:
    """Inicia grabacion y transcripcion."""
    global _recording, _thread
    if _recording:
        return "Ya hay una transcripcion activa."

    params = parameters or {}
    duration = int(params.get("duration", 300))
    use_vosk = params.get("backend", "auto").lower() != "google"
    name = params.get("name", f"reunion_{int(time.time())}")

    out_dir = Path.home() / "Documents" / "ERIS" / "Transcripciones"
    out_dir.mkdir(parents=True, exist_ok=True)
    output = str(out_dir / f"{name}.txt")

    _recording = True
    _thread = threading.Thread(
        target=_record_worker,
        args=(duration, output, use_vosk, 16000),
        daemon=True,
    )
    _thread.start()

    return f"Transcribiendo {duration}s -> {output}"


def stop_transcription(parameters: dict = None, player=None) -> str:
    """Detiene la transcripcion."""
    global _recording
    if not _recording:
        return "No hay transcripcion activa."
    _recording = False
    if _thread:
        _thread.join(timeout=10)
    return f"Transcripcion guardada: {_output_path}"


def transcription_status(parameters: dict = None, player=None) -> str:
    """Estado de la transcripcion."""
    if _recording:
        return "Transcribiendo..." + (f" -> {_output_path}" if _output_path else "")
    return "Sin transcripcion activa." + (f" Ultima: {_output_path}" if _output_path else "")


def summarize_transcription(parameters: dict = None, player=None) -> str:
    """Resume la ultima transcripcion usando Gemini."""
    if not _output_path or not os.path.isfile(_output_path):
        return "No hay transcripcion para resumir."
    try:
        with open(_output_path, encoding="utf-8") as f:
            text = f.read()
    except Exception:
        return "Error al leer la transcripcion."

    if not text.strip():
        return "La transcripcion esta vacia."

    summary = _summarize_text(text)
    if not summary:
        return "No se pudo generar resumen (sin conexion a Gemini)."

    summary_path = _output_path.replace(".txt", "_resumen.txt")
    with open(summary_path, "w", encoding="utf-8") as f:
        f.write(summary)
    return f"Resumen guardado: {summary_path}\n\n{summary}"
