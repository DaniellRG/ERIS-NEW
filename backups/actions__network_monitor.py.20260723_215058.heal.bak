"""Monitoreo de red: conexiones, ancho de banda, dispositivos, ping, y gestión remota."""
import subprocess
import socket
import threading
import time
import platform
import json
from pathlib import Path


_last_rx = 0
_last_tx = 0
_last_time = time.time()
_monitoring = False
_monitor_thread = None
_bandwidth_log = []
_ssh_clients = {}
_winrm_clients = {}


def _get_psutil():
    try:
        import psutil
        return psutil
    except ImportError:
        return None


def _run_cmd(cmd: list[str]) -> str:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=15, creationflags=subprocess.CREATE_NO_WINDOW)
        return r.stdout.strip() or r.stderr.strip()
    except Exception as e:
        return f"Error: {e}"


def connections(parameters: dict = None, player=None) -> str:
    """Muestra conexiones de red activas."""
    p = _get_psutil()
    if not p:
        return "psutil no disponible."

    kind = (parameters or {}).get("type", "all")
    lines = ["Conexiones activas:"]
    try:
        conns = p.net_connections(kind=kind)
        for c in conns[:30]:
            laddr = f"{c.laddr.ip}:{c.laddr.port}" if c.laddr else "*"
            raddr = f"{c.raddr.ip}:{c.raddr.port}" if c.raddr else "*"
            lines.append(f"  {c.type.name:8} {laddr:22} -> {raddr:22} {c.status or ''}")
    except Exception as e:
        return f"Error: {e}"
    return "\n".join(lines) if len(lines) > 1 else "Sin conexiones activas."


def bandwidth(parameters: dict = None, player=None) -> str:
    """Muestra uso de ancho de banda en tiempo real."""
    p = _get_psutil()
    if not p:
        return "psutil no disponible."

    interval = int((parameters or {}).get("interval", 1))
    before = p.net_io_counters()
    time.sleep(interval)
    after = p.net_io_counters()

    rx = (after.bytes_recv - before.bytes_recv) / interval
    tx = (after.bytes_sent - before.bytes_sent) / interval

    def fmt(bps):
        if bps > 1_000_000:
            return f"{bps/1_000_000:.1f} MB/s"
        if bps > 1_000:
            return f"{bps/1_000:.1f} KB/s"
        return f"{bps:.0f} B/s"

    return (
        f"Ancho de banda ({interval}s):\n"
        f"  Descarga: {fmt(rx)}\n"
        f"  Subida:   {fmt(tx)}\n"
        f"  Total RX: {after.bytes_recv/1_000_000_000:.2f} GB\n"
        f"  Total TX: {after.bytes_sent/1_000_000_000:.2f} GB"
    )


def wifi_info(parameters: dict = None, player=None) -> str:
    """Muestra informacion de la red WiFi."""
    lines = []
    info = _run_cmd(["netsh", "wlan", "show", "interfaces"])
    lines.append(info)

    try:
        hostname = socket.gethostname()
        local_ip = socket.gethostbyname(hostname)
        lines.append(f"\nHostname: {hostname}")
        lines.append(f"IP Local: {local_ip}")
    except Exception:
        pass
    return "\n".join(lines)


def ping_host(parameters: dict = None, player=None) -> str:
    """Hace ping a un host."""
    params = parameters or {}
    host = params.get("host", "8.8.8.8")
    count = int(params.get("count", 4))
    param = "-n" if platform.system().lower() == "windows" else "-c"
    result = _run_cmd(["ping", param, str(count), host])
    return f"Ping a {host}:\n{result}"


def scan_network(parameters: dict = None, player=None) -> str:
    """Escanea dispositivos en la red local."""
    params = parameters or {}
    subnet = params.get("subnet", "192.168.1")
    timeout = int(params.get("timeout", 2))

    found = []
    def _ping(ip):
        param = "-n" if platform.system().lower() == "windows" else "-c"
        r = subprocess.run(
            ["ping", param, "1", "-w", str(timeout * 1000), ip],
            capture_output=True, timeout=timeout + 1,
            creationflags=subprocess.CREATE_NO_WINDOW,
        )
        if r.returncode == 0:
            try:
                host = socket.gethostbyaddr(ip)[0]
            except Exception:
                host = ip
            found.append(f"{ip:16} {host}")

    threads = []
    for i in range(1, 255):
        ip = f"{subnet}.{i}"
        t = threading.Thread(target=_ping, args=(ip,), daemon=True)
        threads.append(t)
        t.start()
        if len(threads) >= 20:
            for t in threads:
                t.join(timeout=timeout + 1)
            threads = []

    for t in threads:
        t.join(timeout=timeout + 1)

    if found:
        return "Dispositivos en red:\n" + "\n".join(found)
    return "No se encontraron dispositivos (restringido por firewall)."


def monitor_start(parameters: dict = None, player=None) -> str:
    """Inicia monitoreo continuo de ancho de banda."""
    global _monitoring, _monitor_thread, _bandwidth_log
    if _monitoring:
        return "Ya monitoreando."

    p = _get_psutil()
    if not p:
        return "psutil no disponible."

    _monitoring = True
    _bandwidth_log = []

    def _loop():
        global _last_rx, _last_tx, _last_time
        before = p.net_io_counters()
        _last_time = time.time()
        while _monitoring:
            time.sleep(1)
            after = p.net_io_counters()
            now = time.time()
            rx = (after.bytes_recv - before.bytes_recv) / (now - _last_time)
            tx = (after.bytes_sent - before.bytes_sent) / (now - _last_time)
            _bandwidth_log.append({"rx": rx, "tx": tx, "t": now})
            _last_rx, _last_tx, _last_time = rx, tx, now
            before = after

    _monitor_thread = threading.Thread(target=_loop, daemon=True)
    _monitor_thread.start()
    return "Monitoreo de red iniciado (intervalo 1s)."


def monitor_stop(parameters: dict = None, player=None) -> str:
    """Detiene monitoreo y muestra resumen."""
    global _monitoring
    if not _monitoring:
        return "Sin monitoreo activo."
    _monitoring = False
    if _bandwidth_log:
        avg_rx = sum(e["rx"] for e in _bandwidth_log) / len(_bandwidth_log)
        avg_tx = sum(e["tx"] for e in _bandwidth_log) / len(_bandwidth_log)
        def fmt(bps):
            if bps > 1_000_000:
                return f"{bps/1_000_000:.1f} MB/s"
            if bps > 1_000:
                return f"{bps/1_000:.1f} KB/s"
            return f"{bps:.0f} B/s"
        return (
            f"Monitoreo detenido ({len(_bandwidth_log)} muestras):\n"
            f"  Promedio descarga: {fmt(avg_rx)}\n"
            f"  Promedio subida:   {fmt(avg_tx)}"
        )
    return "Monitoreo detenido."


def network_status(parameters: dict = None, player=None) -> str:
    """Estado general del monitoreo."""
    p = _get_psutil()
    if p:
        io = p.net_io_counters()
        stats = (
            f"Red activa. Total enviado: {io.bytes_sent/1_000_000:.0f} MB, "
            f"recibido: {io.bytes_recv/1_000_000:.0f} MB"
        )
    else:
        stats = "psutil no disponible."
    if _monitoring:
        stats += "\nMonitoreo en curso."
    return stats


def remote_connect(parameters: dict = None, player=None) -> str:
    """
    Conecta a un dispositivo remoto via SSH (Linux/Mac) o WinRM (Windows).
    Solo dispositivos de tu red local.
    """
    params = parameters or {}
    host = params.get("host", "").strip()
    username = params.get("username", "").strip()
    password = params.get("password", "")
    port = int(params.get("port", 22))
    device_type = params.get("type", "auto")

    if not host or not username:
        return "Faltan parametros: host, username requeridos."

    session_id = f"{host}:{port}"

    try:
        import paramiko
        client = paramiko.SSHClient()
        client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
        if password:
            client.connect(host, port=port, username=username, password=password, timeout=15)
        else:
            key_path = params.get("key_path", str(Path.home() / ".ssh" / "id_rsa"))
            try:
                key = paramiko.RSAKey.from_private_key_file(key_path)
            except Exception:
                key = paramiko.AutoAddPolicy()
            client.connect(host, port=port, username=username, pkey=key, timeout=15)

        _ssh_clients[session_id] = client
        transport = client.get_transport()
        banner = transport.remote_version if transport else "desconocido"
        return f"Conectado a {host}:{port} como {username} [{banner}]"

    except ImportError:
        pass
    except Exception as e:
        return f"Error SSH a {host}:{port}: {e}"

    try:
        import winrm
        ssl_verify = params.get("ssl_verify", "false").lower() == "true"
        proto = "https" if ssl_verify else "http"
        winrm_port = int(params.get("winrm_port", 5985))
        wurl = f"{proto}://{host}:{winrm_port}/wsman"
        session = winrm.Session(wurl, auth=(username, password))
        r = session.run_cmd("hostname")
        if r.status_code == 0:
            _winrm_clients[session_id] = session
            hostname_out = r.std_out.decode("utf-8", errors="replace").strip()
            return f"Conectado a {host} via WinRM como {username} [{hostname_out}]"
        return f"WinRM conectado pero fallo comando: {r.std_err.decode()}"

    except ImportError:
        pass
    except Exception as e:
        return f"Error WinRM a {host}: {e}"

    return "No se pudo conectar. Instala: pip install paramiko (SSH) o pywinrm (Windows)"


def remote_exec(parameters: dict = None, player=None) -> str:
    """Ejecuta un comando en un dispositivo remoto conectado."""
    params = parameters or {}
    host = params.get("host", "").strip()
    port = int(params.get("port", 22))
    command = params.get("command", "").strip()
    session_id = f"{host}:{port}"

    if not command:
        return "Falta el comando a ejecutar."

    if session_id in _ssh_clients:
        try:
            client = _ssh_clients[session_id]
            _, stdout, stderr = client.exec_command(command, timeout=30)
            out = stdout.read().decode("utf-8", errors="replace")
            err = stderr.read().decode("utf-8", errors="replace")
            result = out[:3000]
            if err:
                result += f"\n[STDERR]\n{err[:1000]}"
            return result or "Comando ejecutado (sin salida)."
        except Exception as e:
            return f"Error ejecutando comando: {e}"

    if session_id in _winrm_clients:
        try:
            session = _winrm_clients[session_id]
            r = session.run_cmd(command)
            out = r.std_out.decode("utf-8", errors="replace")
            err = r.std_err.decode("utf-8", errors="replace")
            result = out[:3000]
            if err:
                result += f"\n[STDERR]\n{err[:1000]}"
            return result or "Comando ejecutado (sin salida)."
        except Exception as e:
            return f"Error ejecutando comando WinRM: {e}"

    return f"No hay conexion activa con {host}. Usa remote_connect primero."


def remote_disconnect(parameters: dict = None, player=None) -> str:
    """Desconecta de un dispositivo remoto."""
    params = parameters or {}
    host = params.get("host", "").strip()
    port = int(params.get("port", 22))
    all_flag = params.get("all", "false").lower() == "true"

    if all_flag:
        count = len(_ssh_clients) + len(_winrm_clients)
        for sid, client in list(_ssh_clients.items()):
            try:
                client.close()
            except Exception:
                pass
        _ssh_clients.clear()
        _winrm_clients.clear()
        return f"Desconectado de {count} dispositivos remotos."

    session_id = f"{host}:{port}"
    if session_id in _ssh_clients:
        try:
            _ssh_clients[session_id].close()
        except Exception:
            pass
        del _ssh_clients[session_id]
        return f"Desconectado de {host}:{port}"

    if session_id in _winrm_clients:
        del _winrm_clients[session_id]
        return f"Desconectado de {host}"

    return f"No hay conexion activa con {host}."


def discover_devices(parameters: dict = None, player=None) -> str:
    """Escanea la red local buscando dispositivos y puertos abiertos."""
    params = parameters or {}
    subnet = params.get("subnet", "192.168.1")
    ports = [int(p) for p in params.get("ports", "22,80,443,3389,5985,5986,445,139").split(",") if p.strip()]
    timeout = int(params.get("timeout", 2))

    found = []

    def _check(ip):
        results = []
        for port in ports:
            try:
                s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                s.settimeout(timeout)
                result = s.connect_ex((ip, port))
                s.close()
                if result == 0:
                    try:
                        host = socket.gethostbyaddr(ip)[0]
                    except Exception:
                        host = ip
                    results.append(f"{ip}:{port}")
            except Exception:
                pass
        if results:
            found.append((ip, results))

    threads = []
    for i in range(1, 255):
        ip = f"{subnet}.{i}"
        t = threading.Thread(target=_check, args=(ip,), daemon=True)
        threads.append(t)
        t.start()
        if len(threads) >= 30:
            for t in threads:
                t.join(timeout=timeout + 1)
            threads = []

    for t in threads:
        t.join(timeout=timeout + 1)

    if not found:
        return "No se encontraron dispositivos con puertos abiertos."

    lines = [f"Dispositivos encontrados ({len(found)}):"]
    for ip, open_ports in sorted(found, key=lambda x: x[0]):
        lines.append(f"  {ip}")
        for p in open_ports:
            service = {22: "SSH", 80: "HTTP", 443: "HTTPS", 3389: "RDP",
                       5985: "WinRM-HTTP", 5986: "WinRM-HTTPS", 445: "SMB",
                       139: "NetBIOS"}.get(int(p.split(":")[1]), "")
            svc_tag = f" ({service})" if service else ""
            lines.append(f"    └─ Puerto {p.split(':')[1]}{svc_tag}")
    return "\n".join(lines)
