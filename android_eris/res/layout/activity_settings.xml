<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/Eris_BtnIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="0dp"
            android:text="‹"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Ajustes de ERIS"
            android:textColor="?attr/erisTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/logo_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="E"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="CLAVES DE API"
                android:textColor="?attr/erisAccent"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clave de Gemini (con IA)"
                    android:textColor="?attr/erisTextSecondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/keyGemini"
                        style="@style/Eris_Input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Clave de API de Gemini"
                        android:inputType="textPassword" />

                    <Button
                        android:id="@+id/keyToggle"
                        style="@style/Eris_Btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Ver" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Modelo de Gemini"
                    android:textColor="?attr/erisTextSecondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/modelField"
                    style="@style/Eris_Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="gemini-3.1-flash-lite"
                    android:inputType="text" />

                <Button
                    android:id="@+id/btnTestKey"
                    style="@style/Eris_BtnAccent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Probar conexión" />

                <TextView
                    android:id="@+id/testResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?attr/erisTextSecondary"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="TEMA"
                android:textColor="?attr/erisAccent"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modo"
                    android:textColor="?attr/erisTextSecondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/modeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Color de acento"
                    android:textColor="?attr/erisTextSecondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/accentRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="VOZ"
                android:textColor="?attr/erisAccent"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <Switch
                    android:id="@+id/voiceSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hablar las respuestas"
                    android:textColor="?attr/erisTextPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/geminiVoiceTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Voz de Gemini (elegí y escuchala)"
                    android:textColor="?attr/erisTextSecondary"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/geminiVoiceSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:spinnerMode="dropdown" />

                <Button
                    android:id="@+id/btnAuditionGemini"
                    style="@style/Eris_Btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Audición: probar voces femeninas de Gemini" />

                <TextView
                    android:id="@+id/geminiAuditionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tocá y escuchá cada voz femenina en orden (1, 2, 3…)"
                    android:textColor="?attr/erisTextSecondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnTestVoice"
                    style="@style/Eris_Btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Probar voz" />

                <TextView
                    android:id="@+id/langTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Idioma de dictado"
                    android:textColor="?attr/erisTextSecondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/langRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="COMPORTAMIENTO"
                android:textColor="?attr/erisAccent"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre de tu asistente"
                    android:textColor="?attr/erisTextSecondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/nameField"
                    style="@style/Eris_Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="ERIS" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Personalidad / estilo (lo que ERIS debe ser)"
                    android:textColor="?attr/erisTextSecondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/personalityField"
                    style="@style/Eris_Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:hint="Ej: más divertida, hablame siempre en tu dialecto…"
                    android:inputType="textMultiLine"
                    android:minLines="2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Temperatura"
                        android:textColor="?attr/erisTextSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tempVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="?attr/erisTextPrimary"
                        android:textSize="13sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/tempSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="15" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Máximo de tokens por respuesta"
                    android:textColor="?attr/erisTextSecondary"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/tokenSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Historial recordado (turnos)"
                    android:textColor="?attr/erisTextSecondary"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/histSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="BURBUJA FLOTANTE"
                android:textColor="?attr/erisAccent"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tamaño"
                    android:textColor="?attr/erisTextSecondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/bubbleSizeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal" />

                <Button
                    android:id="@+id/btnBubbleToggle"
                    style="@style/Eris_BtnAccent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Activar burbuja flotante" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="MEMORIA"
                android:textColor="?attr/erisAccent"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnExport"
                        style="@style/Eris_Btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="Exportar" />

                    <Button
                        android:id="@+id/btnImport"
                        style="@style/Eris_Btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:text="Importar" />

                    <Button
                        android:id="@+id/btnClear"
                        style="@style/Eris_Btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Limpiar" />
                </LinearLayout>

                <TextView
                    android:id="@+id/memResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?attr/erisTextSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="PERMISOS Y ESTADO"
                android:textColor="?attr/erisAccent"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <Button
                    android:id="@+id/btnAccess"
                    style="@style/Eris_Btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Accesibilidad" />

                <Button
                    android:id="@+id/btnNotif"
                    style="@style/Eris_Btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Notificaciones" />

                <Button
                    android:id="@+id/btnReset"
                    style="@style/Eris_Btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Restablecer ajustes" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="ERIS v1.0"
                    android:textColor="?attr/erisTextSecondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
