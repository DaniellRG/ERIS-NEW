from fastapi.testclient import TestClient
from main import app, vuelos, reservas, precargar_datos
import datetime

client = TestClient(app)

def test_root():
    response = client.get("/")
    assert response.status_code == 200
    assert response.json() == {"status": "ok"}

def test_get_vuelos():
    precargar_datos()
    response = client.get("/vuelos")
    assert response.status_code == 200
    assert len(response.json()) >= 3

def test_get_vuelo_existente():
    precargar_datos()
    response = client.get("/vuelos/101")
    assert response.status_code == 200
    assert response.json()["origen"] == "EZE"

def test_get_vuelo_no_existente():
    response = client.get("/vuelos/999")
    assert response.status_code == 404

def test_crear_reserva():
    precargar_datos()
    # Limpiar reservas para vuelo 101
    reservas.pop(101, None)

    response = client.post("/reservas?vuelo_id=101&pasajero=Daniel")
    assert response.status_code == 200
    assert response.json()["pasajero"] == "Daniel"
    assert response.json()["estado"] == "confirmada"
    assert vuelos[101].asientos_disponibles == 99

def test_reserva_vuelo_inexistente():
    response = client.post("/reservas?vuelo_id=999&pasajero=Daniel")
    assert response.status_code == 404

def test_reserva_vuelo_lleno():
    precargar_datos()
    vuelos[102].asientos_disponibles = 0
    response = client.post("/reservas?vuelo_id=102&pasajero=Daniel")
    assert response.status_code == 400
    assert "Vuelo lleno" in response.json()["detail"]

def test_reserva_duplicada():
    precargar_datos()
    reservas.pop(101, None)
    client.post("/reservas?vuelo_id=101&pasajero=Daniel")
    response = client.post("/reservas?vuelo_id=101&pasajero=Daniel")
    assert response.status_code == 400
    assert "ya tiene una reserva confirmada" in response.json()["detail"]

def test_cancelar_reserva():
    precargar_datos()
    reservas.pop(101, None)
    response = client.post("/reservas?vuelo_id=101&pasajero=Daniel")
    reserva_id = response.json()["id"]
    
    response = client.put(f"/reservas/{reserva_id}/cancelar")
    assert response.status_code == 200
    assert response.json()["estado"] == "cancelada"
    assert vuelos[101].asientos_disponibles == 100
